# =============================================================================
# Configuración previa del módulo OAuth (Twitch + Kick)
# =============================================================================
# Rellena estos valores ANTES de ejecutar la aplicación.
# Los tokens (access_token, refresh_token, etc.) NO van aquí: se obtienen
# tras el flujo OAuth y se guardan automáticamente en oauth_credentials.json.
# =============================================================================

# ---------------- Twitch (Authorization Code / EventSub) ----------------
TWITCH_ENABLED=true
# Obtén estos valores en https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8765/callback/twitch

# Scopes de Twitch que solicitarás en el flujo de autorización
TWITCH_SCOPES=user:read:email,channel:read:subscriptions,channel:read:redemptions,bits:read,channel:moderate,user:read:chat,user:write:chat,moderator:read:followers,moderator:read:chat_messages

# ---------------- Kick (PKCE / Webhooks) ----------------
KICK_ENABLED=true
# Obtén estos valores en el panel de desarrollador de Kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8765/callback/kick

KICK_PUBLIC_KEY_PEM=

# Scopes de Kick (usa los nombres técnicos exactos de tu panel de Kick, en inglés)
KICK_SCOPES=user:read,user:email,channel:read,channel:edit,chat:write,chat:read,events:subscribe,moderation:manage,chat:moderate,kicks:read,ads:read,ads:manage

# -----------------------------------------------------------------------------
# Servidor local de redirección OAuth (captura del código de autorización)
# -----------------------------------------------------------------------------
OAUTH_LOCAL_HOST=127.0.0.1
OAUTH_LOCAL_PORT=8765
